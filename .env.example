DATABASE_URL=postgresql+asyncpg://studio:studio@localhost:5437/studio
JWT_SECRET=replace-with-at-least-32-random-bytes
APP_TIMEZONE=Asia/Seoul
STORAGE_BACKEND=local
STORAGE_PATH=./storage
LOG_DIR=./log/studio
CORS_ORIGINS=["http://localhost:5173"]
SECURE_COOKIES=false
LOG_SQL=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# --- 아래부터 RENDER_FONT_SIZE까지, 그리고 STOCK_* 3종·계정 정책 3종은 관리자가
# --- [시스템 설정] 화면에서 바꿀 수 있다. 여기 값은 "관리자가 아직 안 바꿨을 때의 기본값"이다.
# --- 각 항목의 허용 범위를 벗어나면 앱이 기동하지 않는다(어떤 키가 문제인지 로그에 찍힌다).

# 허용: fake | openai | claude   (로컬 개발 시 키 없이 쓰려면 fake)
SCRIPT_PROVIDER=openai
# 허용: fake | edge_tts
VOICE_PROVIDER=edge_tts
# 허용: fake | whisper
CAPTIONS_PROVIDER=whisper
# whisper 모델 크기. 허용: tiny | base | small | medium | large-v3 (클수록 정확하고 느리다)
WHISPER_MODEL=small
# 허용: fake | slideshow | stock
RENDER_PROVIDER=slideshow
# 허용: #RRGGBB 6자리 hex (#fff 같은 3자리는 안 된다). 저장 시 소문자로 정규화된다.
RENDER_BG_COLOR=#0f172a
# 허용: 1~100자
RENDER_FONT=Malgun Gothic
# 허용: 8~200
RENDER_FONT_SIZE=30
# 단계 동시 실행 수. whisper·ffmpeg가 CPU를 포화시켜 기본 1을 권장. (시스템 설정 화면에는 없다)
WORKER_CONCURRENCY=1

# 계정 · 보안 (관리자가 [시스템 설정] 화면에서 바꿀 수 있다)
# 연속 로그인 실패 몇 번에 계정을 잠글지. 허용: 1~100 (0으로 잠금을 끌 수는 없다)
FAILED_LOGIN_LIMIT=5
# 비밀번호 최소 길이. 허용: 8~128 — 하한 8은 화면에서도 .env에서도 못 내린다.
PASSWORD_MIN_LEN=8
# true면 가입 즉시 ACTIVE(승인 대기 없이 바로 로그인). false면 관리자 승인 대기.
SIGNUP_AUTO_APPROVE=false

# 스톡 배경 소재 — RENDER_PROVIDER=stock 일 때만 쓴다. 둘 다 무료 발급.
#   Pexels  https://www.pexels.com/api/   (200 req/hour)
#   Pixabay https://pixabay.com/api/docs/ (100 req/60s)
PEXELS_API_KEY=
PIXABAY_API_KEY=
# 검색 순서 = 폴백 우선순위. 키가 있는 소스만 실제로 쓰인다.
# 허용: pexels·pixabay만, 중복 없이, 최소 1개.
STOCK_SOURCES=["pexels","pixabay"]
# 씬당 다운로드 상한(bytes). 허용: 1048576(1MB) ~ 524288000(500MB)
STOCK_MAX_BYTES=52428800
# 소재 다운로드 타임아웃(초). 허용: 5~300
STOCK_TIMEOUT_SEC=30
